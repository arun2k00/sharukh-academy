APP_NAME="Sharukh Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (MySQL 8+ / MariaDB 10.6+) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oacer_academy
DB_USERNAME=oacer_user
DB_PASSWORD=

# --- Shared-hosting friendly drivers -----------------------------------------
# No Redis, no queue worker and no websocket server is required.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# `database` keeps mail off the request path; needs the queue cron in DEPLOYMENT.md.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-host.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Academy settings --------------------------------------------------------
ACADEMY_CURRENCY=INR
ACADEMY_CURRENCY_SYMBOL="₹"
ACADEMY_SUPPORT_EMAIL="support@sharukhacademy.com"
ACADEMY_SUPPORT_PHONE="+91 00000 00000"
# Percentage of lessons that must be completed before a certificate is issued.
ACADEMY_CERTIFICATE_THRESHOLD=100
# Turn on once outgoing mail is verified working.
ACADEMY_REQUIRE_EMAIL_VERIFICATION=true
# Minutes before a live class starts that the join button unlocks.
ACADEMY_LIVE_JOIN_WINDOW=15

# --- Payments ----------------------------------------------------------------
# Leave the driver as "manual" until a real gateway is configured. With "manual"
# no payment is ever processed: paid courses request an enrolment instead and an
# administrator grants access. Razorpay and PhonePe credentials are normally set
# from the admin dashboard (Settings > Payments) instead of here — these are only
# a fallback for a self-hoster who never opens that screen.
PAYMENT_DRIVER=manual

RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Password given to the seeded demo accounts. Local development only.
DEMO_SEED_PASSWORD=password
